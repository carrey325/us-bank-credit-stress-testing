.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials*.json
secrets*.json

# Downloaded bulk archives and local caches.
*.zip
*.7z
*.tar
*.gz
*.bz2
*.xz
.cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

